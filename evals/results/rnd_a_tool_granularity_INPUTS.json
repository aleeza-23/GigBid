              "persona": {
                "type": "string",
                "enum": [
                  "ai_ml_engineer",
                  "fullstack_web_developer",
                  "data_analyst"
                ],
                "description": "Whose portfolio to search."
              },
              "k": {
                "type": "integer",
                "description": "How many items, 1 to 20."
              },
              "filters": {
                "type": "object",
                "properties": {
                  "types": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "outcomes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "description": "Narrow by evidence type or proposal outcome."
              },
              "outcome_aware": {
                "type": "boolean"
              }
            },
            "required": [
              "requirement",
              "persona"
            ],
            "additionalProperties": false
          }
        }
