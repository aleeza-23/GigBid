# evals/results/ IS committed, deliberately: the assignment requires every number in
# the README and the report to trace to a file in here, and CI checks that. Only the
# scratch subdirectory is ignored.
evals/results/scratch/

# Audit log, idempotency store, workspace holds, encrypted OAuth tokens.
# Runtime state and, in the token case, secrets. Never committed.
data/audit/
*.egg-info/

# Playwright artifacts: screenshots, videos and trace zips from the last run.
apps/web/test-results/
apps/web/playwright-report/
# Generated by Next and by tsc.
apps/web/next-env.d.ts
apps/web/tsconfig.tsbuildinfo
