# Copy to .env and fill in. Never commit .env.
# Every variable the system reads is listed here, with no real values.

APP_ENV=development
APP_SECRET_KEY=replace_me
DATABASE_URL=postgresql+psycopg://gigbid:gigbid@localhost:5432/gigbid
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- marketplace
MARKETPLACE_MODE=gigsim
GIGSIM_BASE_URL=http://localhost:8081
GIGSIM_API_TOKEN=replace_me

# GigSim simulator knobs. Seed makes client decisions and error injection reproducible.
GIGSIM_HOST=127.0.0.1
GIGSIM_PORT=8081
GIGSIM_SEED=42
GIGSIM_RATE_LIMIT_PER_MIN=30
GIGSIM_ERROR_RATE=0.0
GIGSIM_CONNECTS_ENFORCED=1
# rule = deterministic scoring (default); llm = a model decides
GIGSIM_CLIENT_ENGINE=rule
GIGSIM_LLM_BASE_URL=http://localhost:11434/v1
GIGSIM_LLM_MODEL=qwen3:4b
GIGSIM_LLM_API_KEY=ollama

# ---------------------------------------------------------------- MCP servers
# stdio locally (no ports, no auth); http for the deployed stack.
MCP_TRANSPORT=stdio
PORTFOLIO_MCP_HOST=127.0.0.1
PORTFOLIO_MCP_PORT=8701
MARKETPLACE_MCP_HOST=127.0.0.1
MARKETPLACE_MCP_PORT=8702
WORKSPACE_MCP_HOST=127.0.0.1
WORKSPACE_MCP_PORT=8703

# Bearer auth on the MCP HTTP endpoints: "token:user_id,token:user_id".
# Unset in production means no caller can authenticate, which is the safe default.
MCP_TOKENS=replace_me:reviewer
MCP_BEARER_TOKEN=replace_me
# Our own limit, kept under GIGSIM_RATE_LIMIT_PER_MIN so we never trip theirs.
MCP_RATE_LIMIT_PER_MIN=20

# Append-only audit log and the durable idempotency store.
MCP_AUDIT_LOG=data/audit/mcp.jsonl
MCP_IDEMPOTENCY_DB=data/audit/idempotency.sqlite3
MCP_IDEMPOTENCY_STALE_SEC=120

# Point the Portfolio server at a different portfolio directory (optional).
# PERSONAS_DIR=/absolute/path/to/your_portfolio

# ----------------------------------------------------------------- workspace
WORKSPACE_BACKEND=local          # local | google
WORKSPACE_DB=data/audit/workspace.sqlite3
WORKSPACE_TZ_OFFSET=5            # PKT
WORKDAY_START_HOUR=9
WORKDAY_END_HOUR=18
# Only for WORKSPACE_BACKEND=google
# GOOGLE_WORKSPACE_CREDENTIALS=/absolute/path/to/credentials.json

# ------------------------------------------------------------------- models
# "open" is required and is what the deployed link runs on. "paid" is optional.
MODEL_PROFILE=open
# Hosted open-weight provider (the deployed host has no GPU). Groq by default;
# change models.profiles.open.base_url in agent/config.yaml for another provider.
GROQ_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
# Only used when MODEL_PROFILE=paid
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --------------------------------------------------- third-party MCP (A5)
# Both opt-in: absent credentials means the server is simply not registered.
# Official Upwork MCP server, live mode only.
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
UPWORK_ACCESS_TOKEN=
UPWORK_USER_ID=
# Minimum seconds between live reads, so polling never looks like scraping (R9).
UPWORK_MIN_INTERVAL_SEC=3.0
# OAuth client, for the API's auth router to complete the flow.
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_REDIRECT_URI=http://localhost:8000/auth/upwork/callback

# Official GitHub MCP server, for ingesting repos into the portfolio corpus.
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
GITHUB_MCP_TOKEN=

# Encrypts stored OAuth tokens at rest. Required for live mode; a missing key
# raises rather than falling back to plaintext. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
OAUTH_TOKEN_DB=data/audit/oauth_tokens.sqlite3

# -------------------------------------------------------------- observability
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gigbid
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
